# ============================================================
# HANGAR 421 — Variables de entorno (raíz / backend cloud)
# Copiar a .env y ajustar por entorno (local / staging / prod)
# ============================================================

# --- Backend / API ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# --- Base de datos cloud (PostgreSQL) ---
DATABASE_URL="postgresql://hangar:hangar_dev_pw@localhost:5432/hangar421?schema=public"

# --- Auth / JWT ---
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars"
JWT_REFRESH_EXPIRES_IN="30d"
PIN_LOGIN_ENABLED=true

# --- WebSockets tiempo real ---
WS_PATH="/realtime"

# --- Sincronización offline ---
SYNC_BATCH_MAX_ITEMS=200
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BACKOFF_MS=2000

# --- Almacenamiento de imágenes (catálogo, logo) ---
ASSETS_PROVIDER=local
ASSETS_LOCAL_PATH=./uploads
# ASSETS_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Correo saliente (reportes de inventario por correo; ver docs/correo.md) ---
# Lo normal es capturarlo en el ERP (Admin → Correo, solo administradores): queda en la base
# cifrado con CORREO_CIFRADO_KEY (si no se define, se reutiliza PAGOS_CIFRADO_KEY). Las variables
# de abajo son el respaldo por servidor cuando la empresa no capturó nada.
CORREO_CIFRADO_KEY=
# Opción A: SMTP (Gmail con contraseña de aplicación, Outlook, dominio propio)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opción B: Resend (gana sobre SMTP si se define)
RESEND_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE="HANGAR 421"

# --- Monitoreo / Logs ---
LOG_LEVEL=info
SENTRY_DSN=

# --- Plataformas de delivery (DiDi / Uber / Rappi) ---
PLATAFORMAS_CIFRADO_KEY="change_me_plataformas_cifrado_key_min_32_chars"
PLATAFORMAS_PUBLIC_BASE_URL=http://localhost:3000/api/v1
# TODO: reemplazar por la URL real de cada plataforma una vez el equipo tenga acceso a
# documentación/credenciales de partner — ver plataformas/proveedores/*.adapter.ts.
# Sin valores secretos aquí: las credenciales de cada plataforma se capturan en el POS
# (Admin → Delivery) y se guardan cifradas con PLATAFORMAS_CIFRADO_KEY. Ver
# docs/plataformas-delivery-apk.md para qué pide cada plataforma.
# DiDi Food (opcional; por defecto https://openapi.didi-food.com/v1). App ID/Secret: tras NDA y
# certificación en developer.didi-food.com.
DIDI_API_BASE_URL=
# Uber Eats (opcionales; por defecto los oficiales https://api.uber.com y
# https://auth.uber.com/oauth/v2/token).
UBER_API_BASE_URL=
UBER_AUTH_URL=
# Rappi: dominio del país (México: https://services.mxgrability.rappi.com; pruebas:
# https://api.dev.rappi.com) — si se deja vacío se elige según el ambiente de la integración.
RAPPI_API_BASE_URL=
RAPPI_AUTH_URL=
# "audience" de Auth0 que Rappi indica al entregar las credenciales (obligatorio para Rappi).
RAPPI_AUTH_AUDIENCE=
# true = permite pedidos de prueba aunque la integración esté en Producción (no recomendado).
PLATAFORMAS_SIMULACION_HABILITADA=false

# --- Frontends (build time) ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:3000
