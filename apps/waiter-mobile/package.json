{
  "name": "@hangar421/waiter-mobile",
  "version": "0.1.5",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android --non-interactive",
    "build:apk": "npm run android:prebuild && cd android && ./gradlew assembleDebug",
    "build:apk:eas": "eas build --platform android --profile preview --local",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@hangar421/shared": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.28",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "socket.io-client": "^4.7.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "^18.3.5",
    "babel-preset-expo": "~11.0.15",
    "typescript": "^5.5.4"
  }
}
