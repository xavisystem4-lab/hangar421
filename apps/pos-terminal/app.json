{
  "expo": {
    "name": "HANGAR 421 Punto de Venta",
    "slug": "hangar421-pos-terminal",
    "version": "0.1.16",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0B1E33"
    },
    "android": {
      "package": "com.hangar421.pos",
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1E33"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "extra": {
      "erpApiUrl": "https://hangar421backend-production.up.railway.app/api/v1"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ]
  }
}
