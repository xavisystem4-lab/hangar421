<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Para listar las apps instaladas (elegir cuál vigilar) en Android 11+. -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <application>
    <!-- Servicio que recibe las notificaciones de las demás apps. Android solo lo activa cuando
         el usuario concede "Acceso a notificaciones" a esta app (Ajustes), que la propia app abre
         desde Admin → Plataformas. Se fusiona en el manifest de la app al compilar. -->
    <service
      android:name="expo.modules.hangarnotificaciones.EscuchaNotificaciones"
      android:label="HANGAR 421 Punto de Venta"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
