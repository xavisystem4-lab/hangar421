// ============================================================================
// HANGAR 421 — Esquema de datos central (PostgreSQL, cloud)
// Jerarquía: Empresa -> Sucursal -> Area/Estación -> Dispositivo -> Usuario -> Operación
// Cada terminal local (POS Windows, tablets) replica un subconjunto en SQLite
// y sincroniza contra este esquema vía /sync (ver docs/sync-flows.md).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN_CORPORATIVO
  ADMIN_SUCURSAL
  CAJERO
  MESERO
  COCINA
  SUPERVISOR
}

enum TipoArea {
  SALON
  BARRA
  COCINA
  CAJA
  ESTACION_COCINA
  ALMACEN
}

enum TipoDispositivo {
  POS_WINDOWS
  TABLET_MESERO
  CELULAR_MESERO
  PANTALLA_COCINA
  OTRO
}

enum EstadoMesa {
  LIBRE
  OCUPADA
  RESERVADA
  POR_COBRAR
  PEDIDO_LISTO
}

enum TipoPedido {
  MESA
  MOSTRADOR
  DOMICILIO
}

enum EstadoPedido {
  ABIERTO
  ENVIADO
  EN_PREPARACION
  LISTO
  ENTREGADO
  POR_COBRAR
  COBRADO
  CANCELADO
}

enum EstadoPedidoItem {
  NUEVO
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum CanalOrigen {
  POS_WINDOWS
  APP_MESERO
  CRM
  PLATAFORMA_DELIVERY
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  QR
  OTRO
}

enum EstadoConexionTerminal {
  CONECTADA
  DESCONECTADA
  OCUPADA
  ERROR
}

enum AmbienteProveedorPago {
  PRUEBAS
  PRODUCCION
}

// Estados del ciclo de vida de una solicitud de pago con tarjeta (ver PaymentRequest). El
// backend es la única fuente de verdad: ni el POS ni la APK marcan un pago como APROBADO por su
// cuenta — siempre llega por webhook/consulta al proveedor (ver pagos/proveedores/*.adapter.ts).
enum EstadoSolicitudPago {
  PENDIENTE
  ENVIADO_A_TERMINAL
  EN_PROCESO
  APROBADO
  RECHAZADO
  CANCELADO
  EXPIRADO
  ERROR
}

// Quién originó un PaymentEvent — para poder auditar si un cambio de estado vino de una acción
// humana (POS/APK) o de un sistema externo (proveedor/webhook) o interno (expiración automática).
enum OrigenEventoPago {
  POS
  APK
  PROVEEDOR
  WEBHOOK
  SISTEMA
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
  MERMA
  CONTEO
  TRASPASO_SALIDA
  TRASPASO_ENTRADA
}

enum EstadoTraspaso {
  SOLICITADO
  AUTORIZADO
  ENVIADO
  RECIBIDO
  VALIDADO
  CANCELADO
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  ERROR
}

enum SyncOperacion {
  CREATE
  UPDATE
  DELETE
}

enum TipoDescuento {
  MONTO
  PORCENTAJE
}

enum EstacionPreparacion {
  BARRA
  COCINA
  POSTRES
}

enum TurnoTrabajo {
  MATUTINO
  VESPERTINO
  NOCTURNO
  MIXTO
}

enum AmbientePlataforma {
  SANDBOX
  PRODUCCION
}

enum EstadoConexionPlataforma {
  CONECTADA
  DESCONECTADA
  PENDIENTE_CONFIGURACION
  ERROR
}

enum EstadoSincronizacionOrdenPlataforma {
  RECIBIDA
  SINCRONIZADA
  ERROR
  IGNORADA
}

// ---------------------------------------------------------------------------
// Jerarquía organizacional
// ---------------------------------------------------------------------------

model Empresa {
  id        String   @id @default(uuid())
  nombre    String
  rfc       String?
  logoUrl   String?
  configJson Json?   @default("{}")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sucursales   Sucursal[]
  usuarios     Usuario[]
  perfiles     Perfil[]
  areasImpresion AreaImpresion[]
  categorias   CategoriaProducto[]
  productos    Producto[]
  modificadores Modificador[]
  insumos      Insumo[]
  proveedores  Proveedor[]
  clientes     Cliente[]
  auditLogs    AuditLog[]
  paymentProviderConfigs PaymentProviderConfig[]
  paymentTerminals       PaymentTerminal[]
  paymentRequests        PaymentRequest[]
  plataformaConfigs      PlataformaConfig[]

  @@map("empresas")
}

model Sucursal {
  id          String   @id @default(uuid())
  empresaId   String
  nombre      String
  direccion   String?
  horarioApertura String? // "07:00"
  horarioCierre   String? // "21:00"
  timezone    String   @default("America/Mexico_City")
  moneda      String   @default("MXN")
  tasaImpuesto Decimal @default(0.16) @db.Decimal(5, 4)
  configJson  Json?    @default("{}")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa     Empresa  @relation(fields: [empresaId], references: [id])

  areas             Area[]
  dispositivos      Dispositivo[]
  cajas             Caja[]
  mesas             Mesa[]
  usuariosSucursal  UsuarioSucursal[]
  productosSucursal ProductoSucursal[]
  inventario        InventarioSucursal[]
  pedidos           Pedido[]
  turnos            Turno[]
  movimientosInv    MovimientoInventario[]
  traspasosOrigen   Traspaso[] @relation("TraspasoOrigen")
  traspasosDestino  Traspaso[] @relation("TraspasoDestino")
  auditLogs         AuditLog[]
  horarios          HorarioUsuario[]
  paymentProviderConfigs PaymentProviderConfig[]
  paymentTerminals       PaymentTerminal[]
  paymentRequests        PaymentRequest[]
  plataformaConfigs      PlataformaConfig[]

  @@index([empresaId])
  @@map("sucursales")
}

model Area {
  id         String   @id @default(uuid())
  sucursalId String
  nombre     String
  tipo       TipoArea
  descripcion String?
  activo     Boolean  @default(true)

  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  mesas       Mesa[]
  dispositivos Dispositivo[]

  @@index([sucursalId])
  @@map("areas")
}

model Dispositivo {
  id             String   @id @default(uuid())
  sucursalId     String
  areaId         String?
  nombre         String
  tipo           TipoDispositivo
  identificador  String   @unique // huella única del hardware/instalación
  ultimaConexion DateTime?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  sucursal  Sucursal @relation(fields: [sucursalId], references: [id])
  area      Area?    @relation(fields: [areaId], references: [id])

  pedidos       Pedido[]
  syncItems     SyncQueueItem[]
  auditLogs     AuditLog[]

  @@index([sucursalId])
  @@map("dispositivos")
}

model Usuario {
  id           String   @id @default(uuid())
  empresaId    String
  nombre       String
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  pinHash      String?
  activo       Boolean  @default(true)
  // Baja lógica permanente (botón "Eliminar" en CRM) — distinta de `activo` (que solo
  // suspende temporalmente vía Activar/Desactivar). Nunca se borra el registro: conserva
  // el historial de pedidos, turnos de caja y auditoría que ya lo referencian.
  eliminado    Boolean  @default(false)
  eliminadoAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa      Empresa  @relation(fields: [empresaId], references: [id])

  sucursales     UsuarioSucursal[]
  pedidosMesero  Pedido[] @relation("PedidoMesero")
  pedidosCajero  Pedido[] @relation("PedidoCajero")
  turnos         Turno[]
  movimientosCaja MovimientoCaja[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  horarios       HorarioUsuario[]
  terminalesAsignadas   PaymentTerminal[] @relation("TerminalMeseroAsignado")
  pagosComoMesero       PaymentRequest[]  @relation("PaymentRequestMesero")
  pagosCreados          PaymentRequest[]  @relation("PaymentRequestCreadoPor")
  pushTokens            PushToken[]

  @@index([empresaId])
  @@map("usuarios")
}

model UsuarioSucursal {
  id          String     @id @default(uuid())
  usuarioId   String
  sucursalId  String
  rol         RolUsuario
  turno       TurnoTrabajo?
  perfilId    String?
  permisosJson Json?     @default("{}")
  activo      Boolean    @default(true)

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  sucursal  Sucursal @relation(fields: [sucursalId], references: [id])
  perfil    Perfil?  @relation(fields: [perfilId], references: [id])

  @@unique([usuarioId, sucursalId])
  @@index([sucursalId])
  @@index([perfilId])
  @@map("usuarios_sucursales")
}

// Perfil de permisos: capa adicional sobre RolUsuario (que sigue controlando el acceso base
// a los módulos del backend vía RolesGuard). Un Perfil es un conjunto reutilizable y nombrado
// de claves de PERMISOS (ver packages/shared/src/constants.ts) que un ADMIN puede armar con
// checkboxes desde el botón "Perfiles" del CRM y asignar a usuarios para afinar qué acciones
// finas puede realizar dentro de su rol (ej. un Cajero con permiso de aplicar descuentos).
model Perfil {
  id          String   @id @default(uuid())
  empresaId   String
  nombre      String
  descripcion String?
  permisos    String[] @default([])
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa      Empresa           @relation(fields: [empresaId], references: [id])
  asignaciones UsuarioSucursal[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("perfiles")
}

// Estaciones de impresión (Barra, Cocina, Caja, etc.) — por ahora solo un catálogo con nombre
// para organizar el menú (ver AdminTicket.tsx §"Áreas de impresión"); la asignación de un
// producto a una estación y el enrutamiento real a una impresora por estación quedan para una
// siguiente entrega (hoy solo hay una impresora de cocina configurada por sucursal).
model AreaImpresion {
  id        String   @id @default(uuid())
  empresaId String
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("areas_impresion")
}

// Horario semanal recurrente de un empleado en una sucursal (no es el turno de caja — ver
// modelo Turno, que es la apertura/cierre real de una caja con corte de efectivo).
model HorarioUsuario {
  id         String   @id @default(uuid())
  usuarioId  String
  sucursalId String
  diaSemana  Int      // 0=domingo … 6=sábado
  horaInicio String   // "09:00"
  horaFin    String   // "17:00"
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  sucursal Sucursal @relation(fields: [sucursalId], references: [id])

  @@index([usuarioId])
  @@index([sucursalId])
  @@map("horarios_usuario")
}

model RefreshToken {
  id         String   @id @default(uuid())
  usuarioId  String
  tokenHash  String   @unique
  dispositivoId String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model CategoriaProducto {
  id        String   @id @default(uuid())
  empresaId String
  nombre    String
  orden     Int      @default(0)
  icono     String?
  color     String?
  activo    Boolean  @default(true)

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@index([empresaId])
  @@map("categorias_producto")
}

model Producto {
  id           String   @id @default(uuid())
  empresaId    String
  categoriaId  String
  nombre       String
  descripcion  String?
  subcategoria String?  // agrupación visual dentro de la categoría (ej. "Galletas by Domingo")
  imagenUrl    String?
  precioBase   Decimal  @db.Decimal(10, 2)
  orden        Int      @default(0) // orden visual dentro de la categoría/subcategoría
  activo       Boolean  @default(true)
  requierePersonalizacion Boolean @default(false) // abre el modal de personalización antes de agregarse al pedido
  estacionPreparacion EstacionPreparacion?
  impuestoOverride Decimal? @db.Decimal(5, 4) // null = usa la tasa de la sucursal (Sucursal.tasaImpuesto)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa     Empresa            @relation(fields: [empresaId], references: [id])
  categoria   CategoriaProducto  @relation(fields: [categoriaId], references: [id])

  sucursales       ProductoSucursal[]
  modificadores    ProductoModificador[]
  receta           RecetaItem[]
  pedidoItems      PedidoItem[]

  @@index([empresaId])
  @@index([categoriaId])
  @@map("productos")
}

model ProductoSucursal {
  id          String   @id @default(uuid())
  productoId  String
  sucursalId  String
  precio      Decimal  @db.Decimal(10, 2)
  disponible  Boolean  @default(true)
  stockControlado Boolean @default(false)

  producto  Producto @relation(fields: [productoId], references: [id])
  sucursal  Sucursal @relation(fields: [sucursalId], references: [id])

  @@unique([productoId, sucursalId])
  @@index([sucursalId])
  @@map("productos_sucursal")
}

model Modificador {
  id          String   @id @default(uuid())
  empresaId   String
  nombre      String
  tipo        String   @default("SELECCION_UNICA") // SELECCION_UNICA | MULTIPLE
  obligatorio Boolean  @default(false)

  empresa  Empresa @relation(fields: [empresaId], references: [id])
  opciones OpcionModificador[]
  productos ProductoModificador[]

  @@index([empresaId])
  @@map("modificadores")
}

model OpcionModificador {
  id            String  @id @default(uuid())
  modificadorId String
  nombre        String
  precioExtra   Decimal @default(0) @db.Decimal(10, 2)
  orden         Int     @default(0)

  modificador Modificador @relation(fields: [modificadorId], references: [id])
  pedidoItemModificadores PedidoItemModificador[]

  @@index([modificadorId])
  @@map("opciones_modificador")
}

model ProductoModificador {
  id            String @id @default(uuid())
  productoId    String
  modificadorId String
  orden         Int    @default(0)

  producto    Producto    @relation(fields: [productoId], references: [id])
  modificador Modificador @relation(fields: [modificadorId], references: [id])

  @@unique([productoId, modificadorId])
  @@map("producto_modificadores")
}

// ---------------------------------------------------------------------------
// Salón / mesas
// ---------------------------------------------------------------------------

model Mesa {
  id         String     @id @default(uuid())
  sucursalId String
  areaId     String?
  nombre     String
  capacidad  Int        @default(2)
  estado     EstadoMesa @default(LIBRE)
  // Baja lógica (nunca se borra: conservaría el historial de pedidos que ya la referencian) —
  // agregado para poder limpiar mesas duplicadas desde la UI sin tocar la base a mano. Ver
  // AdminMesas.tsx y mesas.service.ts (actualizar() rechaza dar de baja una mesa que no esté
  // LIBRE, para no desactivar por error la que sigue en uso).
  activo     Boolean    @default(true)

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  area     Area?    @relation(fields: [areaId], references: [id])
  pedidos  Pedido[]
  paymentRequests PaymentRequest[]

  @@index([sucursalId])
  @@map("mesas")
}

// ---------------------------------------------------------------------------
// Caja y turnos
// ---------------------------------------------------------------------------

model Caja {
  id         String  @id @default(uuid())
  sucursalId String
  nombre     String
  activo     Boolean @default(true)

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  turnos   Turno[]
  paymentTerminals PaymentTerminal[]

  @@index([sucursalId])
  @@map("cajas")
}

model Turno {
  id                String    @id @default(uuid())
  sucursalId        String
  cajaId            String
  usuarioId         String
  montoInicial      Decimal   @db.Decimal(10, 2)
  montoFinalDeclarado Decimal? @db.Decimal(10, 2)
  montoFinalSistema Decimal?  @db.Decimal(10, 2)
  diferencia        Decimal?  @db.Decimal(10, 2)
  desgloseEfectivo  Json?     // conteo de billetes/monedas MXN y billetes USD declarados al corte
  estado            EstadoTurno @default(ABIERTO)
  fechaApertura     DateTime  @default(now())
  fechaCierre       DateTime?

  sucursal    Sucursal          @relation(fields: [sucursalId], references: [id])
  caja        Caja              @relation(fields: [cajaId], references: [id])
  usuario     Usuario           @relation(fields: [usuarioId], references: [id])
  movimientos MovimientoCaja[]

  @@index([sucursalId])
  @@index([cajaId])
  @@map("turnos")
}

// Entradas/salidas de efectivo de caja durante un turno que NO son ventas (ej. retiro para
// cambio, pago a proveedor de contado, depósito extra) — se incluyen en el corte de caja para
// que el efectivo contado cuadre contra lo esperado.
model MovimientoCaja {
  id        String             @id @default(uuid())
  turnoId   String
  tipo      TipoMovimientoCaja
  monto     Decimal            @db.Decimal(10, 2)
  motivo    String
  usuarioId String
  createdAt DateTime           @default(now())

  turno   Turno   @relation(fields: [turnoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([turnoId])
  @@map("movimientos_caja")
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

model Pedido {
  id            String       @id @default(uuid()) // generado en cliente (UUID v7)
  empresaId     String
  sucursalId    String
  mesaId        String?
  clienteId     String?
  folio         String
  tipo          TipoPedido
  numComensales Int?         @default(1)
  meseroId      String?
  cajeroId      String?
  dispositivoId String?
  canalOrigen   CanalOrigen
  estado        EstadoPedido @default(ABIERTO)
  notasGenerales String?
  subtotal      Decimal      @default(0) @db.Decimal(10, 2)
  impuesto      Decimal      @default(0) @db.Decimal(10, 2)
  descuentoTotal Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal      @default(0) @db.Decimal(10, 2)

  syncStatus      SyncStatus @default(SYNCED)
  idempotencyKey  String?    @unique
  createdAtLocal  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sucursal Sucursal      @relation(fields: [sucursalId], references: [id])
  mesa     Mesa?         @relation(fields: [mesaId], references: [id])
  cliente  Cliente?      @relation(fields: [clienteId], references: [id])
  mesero   Usuario?      @relation("PedidoMesero", fields: [meseroId], references: [id])
  cajero   Usuario?      @relation("PedidoCajero", fields: [cajeroId], references: [id])
  dispositivo Dispositivo? @relation(fields: [dispositivoId], references: [id])

  items       PedidoItem[]
  pagos       Pago[]
  descuentos  Descuento[]
  paymentRequests PaymentRequest[]
  plataformaOrdenSyncs PlataformaOrdenSync[]

  @@unique([sucursalId, folio])
  @@index([sucursalId, estado])
  @@index([mesaId])
  @@map("pedidos")
}

model PedidoItem {
  id             String            @id @default(uuid())
  pedidoId       String
  productoId     String
  cantidad       Int               @default(1)
  precioUnitario Decimal           @db.Decimal(10, 2)
  notas          String?
  estado         EstadoPedidoItem  @default(NUEVO)
  estacionCocinaId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  pedido    Pedido   @relation(fields: [pedidoId], references: [id])
  producto  Producto @relation(fields: [productoId], references: [id])

  modificadores PedidoItemModificador[]

  @@index([pedidoId])
  @@index([estado])
  @@map("pedido_items")
}

model PedidoItemModificador {
  id                  String @id @default(uuid())
  pedidoItemId        String
  opcionModificadorId String
  precioExtra         Decimal @db.Decimal(10, 2)

  pedidoItem        PedidoItem        @relation(fields: [pedidoItemId], references: [id])
  opcionModificador OpcionModificador @relation(fields: [opcionModificadorId], references: [id])

  @@map("pedido_item_modificadores")
}

model Descuento {
  id            String       @id @default(uuid())
  pedidoId      String
  tipo          TipoDescuento
  valor         Decimal      @db.Decimal(10, 2)
  montoAplicado Decimal      @db.Decimal(10, 2)
  motivo        String
  autorizadoPorId String?
  createdAt     DateTime     @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@map("descuentos")
}

model Pago {
  id         String     @id @default(uuid())
  pedidoId   String
  metodo     MetodoPago
  monto      Decimal    @db.Decimal(10, 2)
  referencia String?
  usuarioId  String?
  createdAt  DateTime   @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@map("pagos")
}

// ---------------------------------------------------------------------------
// Pagos con tarjeta (terminales físicas / proveedores externos, ej. Mercado Pago Point)
//
// Arquitectura de adaptadores: `proveedor` es un código libre (no un enum de Prisma) resuelto en
// tiempo de ejecución contra un registro de adaptadores en el backend (ver
// pagos/proveedores/proveedor-pago.interface.ts) — así se puede sumar un banco nuevo con un
// adaptador de código nuevo, sin migración de base de datos.
// ---------------------------------------------------------------------------

model PaymentProviderConfig {
  id        String   @id @default(uuid())
  empresaId String
  // null = aplica a toda la empresa; una sucursal puede tener su propia cuenta/credenciales
  // (ej. dos franquicias con cuentas de Mercado Pago distintas).
  sucursalId String?
  // Código del adaptador (ej. "mercadopago", "mock") — ver ProveedorPagoRegistry.
  proveedor  String
  ambiente   AmbienteProveedorPago @default(PRUEBAS)
  // JSON cifrado (AES-256-GCM, ver common/crypto/cifrado.service.ts) con access token, public
  // key, client secret, webhook secret, etc. — el contenido varía por proveedor y NUNCA se manda
  // al frontend ni a la APK; solo el backend lo descifra para llamar al proveedor.
  credencialesCifradas String
  identificadorComercio String? // user_id / store_id / merchant id, según el proveedor
  webhookUrl String?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa    Empresa           @relation(fields: [empresaId], references: [id])
  sucursal   Sucursal?         @relation(fields: [sucursalId], references: [id])
  terminales PaymentTerminal[]

  @@unique([empresaId, sucursalId, proveedor])
  @@index([empresaId])
  @@map("payment_provider_configs")
}

model PaymentTerminal {
  id                 String   @id @default(uuid())
  empresaId          String
  sucursalId         String
  cajaId             String?
  proveedorConfigId  String
  nombre             String
  zona               String?
  meseroAsignadoId   String?
  // device_id de Mercado Pago Point (u homólogo de otro proveedor) — lo que el adaptador manda
  // en cada llamada a la API del proveedor para identificar la terminal física.
  identificadorExterno String
  // Overrides específicos de esta terminal, cifrados (opcional — la mayoría de la config vive en
  // PaymentProviderConfig, a nivel cuenta).
  configuracionCifrada String?
  activo               Boolean  @default(true)
  estadoConexion       EstadoConexionTerminal @default(DESCONECTADA)
  ultimaSincronizacion DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  empresa         Empresa               @relation(fields: [empresaId], references: [id])
  sucursal        Sucursal              @relation(fields: [sucursalId], references: [id])
  caja            Caja?                 @relation(fields: [cajaId], references: [id])
  meseroAsignado  Usuario?              @relation("TerminalMeseroAsignado", fields: [meseroAsignadoId], references: [id])
  proveedorConfig PaymentProviderConfig @relation(fields: [proveedorConfigId], references: [id])
  solicitudes     PaymentRequest[]

  @@unique([proveedorConfigId, identificadorExterno])
  @@index([sucursalId])
  @@map("payment_terminals")
}

model PaymentRequest {
  id         String   @id @default(uuid())
  empresaId  String
  sucursalId String
  pedidoId   String
  mesaId     String?
  meseroId   String?
  terminalId String
  proveedor  String
  // Lo que el backend manda al proveedor como "external_reference" (ej. Mercado Pago) — permite
  // conciliar el webhook con esta solicitud sin depender de que el proveedor devuelva rápido su
  // propio id. Es distinto del `id` (UUID interno) para tener un código corto legible en tickets.
  referenciaInterna String  @unique
  // payment_intent id / payment id que asigna el proveedor — llega en la respuesta de
  // crearSolicitudDePago() y se confirma/actualiza vía webhook.
  referenciaExterna String?
  importe        Decimal  @db.Decimal(10, 2)
  moneda         String   @default("MXN")
  estado         EstadoSolicitudPago @default(PENDIENTE)
  // Evita duplicar el cobro ante un doble tap de "Tarjeta" en el POS o un reintento de red —
  // ver PagosService.crearSolicitud().
  idempotencyKey String   @unique
  creadoPorId    String
  motivoError    String?
  expiraEn       DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa   Empresa         @relation(fields: [empresaId], references: [id])
  sucursal  Sucursal        @relation(fields: [sucursalId], references: [id])
  pedido    Pedido          @relation(fields: [pedidoId], references: [id])
  mesa      Mesa?           @relation(fields: [mesaId], references: [id])
  mesero    Usuario?        @relation("PaymentRequestMesero", fields: [meseroId], references: [id])
  creadoPor Usuario         @relation("PaymentRequestCreadoPor", fields: [creadoPorId], references: [id])
  terminal  PaymentTerminal @relation(fields: [terminalId], references: [id])
  eventos   PaymentEvent[]

  @@index([pedidoId])
  @@index([terminalId])
  @@index([estado])
  @@map("payment_requests")
}

model PaymentEvent {
  id                String   @id @default(uuid())
  paymentRequestId  String
  // Ej. "CREADA", "ENVIADA_A_TERMINAL", "WEBHOOK_APROBADO", "EXPIRADA_AUTOMATICAMENTE" — texto
  // libre (no enum) para no tener que migrar cada vez que se agrega un matiz de auditoría nuevo.
  tipoEvento        String
  origen            OrigenEventoPago
  // Nunca incluye PAN/CVV/fecha de vencimiento — solo campos no sensibles del payload del
  // proveedor (id, status, status_detail, etc.), filtrados en el adaptador antes de guardar.
  payloadSanitizado Json?
  createdAt         DateTime @default(now())

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id])

  @@index([paymentRequestId])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Plataformas de delivery (DiDi / Uber / Rappi)
//
// Misma arquitectura de adaptadores que "Pagos con tarjeta" arriba: `plataforma` es un código
// libre (no un enum de Prisma) resuelto en tiempo de ejecución contra PlataformaDeliveryRegistry
// (ver plataformas/proveedores/plataforma-delivery.interface.ts) — así se puede sumar una
// plataforma nueva con un adaptador de código nuevo, sin migración de base de datos. El valor
// esperado hoy ("didi"|"uber"|"rappi") sí se valida a nivel API contra el enum compartido
// PlataformaDelivery (@hangar421/shared).
// ---------------------------------------------------------------------------

model PlataformaConfig {
  id        String   @id @default(uuid())
  empresaId String
  // null = aplica a toda la empresa (único caso que ofrece la UI v1 del CRM); una sucursal
  // puede tener su propia cuenta/credenciales si más adelante se necesita.
  sucursalId String?
  // Código del adaptador (ej. "didi", "uber", "rappi") — ver PlataformaDeliveryRegistry.
  plataforma String
  ambiente   AmbientePlataforma @default(SANDBOX)
  activo     Boolean            @default(false)
  estadoConexion EstadoConexionPlataforma @default(PENDIENTE_CONFIGURACION)
  // JSON cifrado (AES-256-GCM, ver common/crypto/cifrado.service.ts) con apiKey/clientId,
  // clientSecret, webhookSecret, etc. — el contenido varía por plataforma y NUNCA se manda al
  // frontend; solo el backend lo descifra para llamar a la API de la plataforma. null hasta el
  // primer guardado.
  credencialesCifradas String?
  // Últimos 4 caracteres del campo principal (apiKey/clientId), en claro — no es secreto por sí
  // solo y es lo que el CRM muestra como "•••• 1234" en vez de pedir de nuevo la credencial.
  credencialesUltimos4 String?
  clientSecretConfigurado Boolean @default(false)
  identificadorTienda String? // store/restaurant id en la plataforma externa
  // Segmento rotable de la URL de webhook — "Regenerar URL" reemplaza este valor por uno nuevo.
  webhookSlug String @unique @default(uuid())
  ultimaSincronizacion DateTime?
  ultimoErrorMensaje   String?
  ultimoErrorEn        DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id])

  webhookEvents PlataformaWebhookEvent[]
  ordenSyncs    PlataformaOrdenSync[]

  @@unique([empresaId, sucursalId, plataforma])
  @@index([empresaId])
  @@index([sucursalId])
  @@map("plataforma_configs")
}

// Registro de cada evento de webhook recibido, con el id externo de evento como clave de
// idempotencia — un reintento del mismo evento (misma plataforma/config) choca contra el
// @@unique y se descarta sin reprocesar (ver PlataformasService.manejarWebhook()).
model PlataformaWebhookEvent {
  id                 String   @id @default(uuid())
  plataformaConfigId String
  eventoExternoId    String
  tipoEvento         String
  payloadSanitizado  Json?
  procesadoOk        Boolean  @default(true)
  motivoError        String?
  createdAt          DateTime @default(now())

  plataformaConfig PlataformaConfig @relation(fields: [plataformaConfigId], references: [id])

  @@unique([plataformaConfigId, eventoExternoId])
  @@index([plataformaConfigId, createdAt])
  @@map("plataforma_webhook_events")
}

// Rastreo de pedidos recibidos desde una plataforma de delivery. No crea un `Pedido` real
// todavía (falta definir el mapeo de productos/SKU contra el catálogo propio, ver
// docs/pagos-tarjeta.md-style pendiente en plataformas — pendiente documentado) — solo garantiza
// que un mismo pedido externo nunca se procese dos veces y deja rastro para el panel de
// "pedidos recibidos/sincronizados" y errores recientes.
model PlataformaOrdenSync {
  id                 String   @id @default(uuid())
  plataformaConfigId String
  ordenExternaId     String
  estado             EstadoSincronizacionOrdenPlataforma @default(RECIBIDA)
  pedidoId           String?
  motivoError        String?
  // Extraídos del payload del webhook (ver *.adapter.ts -> procesarWebhook) para poder listar la
  // bandeja de "Pedidos entrantes" sin tener que parsear payloadSanitizado en cada fila — los
  // items completos (nombre/cantidad tal como los mandó la plataforma) siguen viviendo dentro de
  // payloadSanitizado.items, ya que su forma varía por plataforma y no necesitan índice propio.
  clienteNombre      String?
  totalExterno       Decimal? @db.Decimal(10, 2)
  payloadSanitizado  Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  plataformaConfig PlataformaConfig @relation(fields: [plataformaConfigId], references: [id])
  pedido           Pedido?          @relation(fields: [pedidoId], references: [id])

  @@unique([plataformaConfigId, ordenExternaId])
  @@index([plataformaConfigId, estado])
  @@map("plataforma_orden_syncs")
}

// Token de push (FCM) por dispositivo de la app de Meseros — para poder despertarla cuando está
// en segundo plano o cerrada. Se registra desde la APK al iniciar sesión (ver
// waiter-mobile/src/push.ts) contra POST /pagos/push-tokens.
model PushToken {
  id            String   @id @default(uuid())
  usuarioId     String
  dispositivoId String?
  token         String   @unique
  plataforma    String   @default("android")
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("push_tokens")
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

model Insumo {
  id            String  @id @default(uuid())
  empresaId     String
  proveedorId   String? // opcional: de qué proveedor se compra este insumo
  nombre        String
  unidadMedida  String  // "g", "ml", "pz", "kg", "l"
  costoUnitario Decimal @default(0) @db.Decimal(10, 4)
  // Precio de venta directa (opcional) — solo aplica a insumos que también se venden tal cual
  // (ej. agua embotellada, refresco de lata) sin pasar por una receta de producto. null = este
  // insumo no se vende directo, solo se usa como ingrediente (ver RecetaItem).
  precioVenta   Decimal? @db.Decimal(10, 2)
  activo        Boolean @default(true)

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  proveedor Proveedor? @relation(fields: [proveedorId], references: [id])

  receta        RecetaItem[]
  inventario    InventarioSucursal[]
  movimientos   MovimientoInventario[]
  traspasoItems TraspasoItem[]

  @@index([empresaId])
  @@index([proveedorId])
  @@map("insumos")
}

model Proveedor {
  id        String   @id @default(uuid())
  empresaId String
  nombre    String
  telefono  String?
  email     String?
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  insumos Insumo[]

  @@index([empresaId])
  @@map("proveedores")
}

model RecetaItem {
  id         String  @id @default(uuid())
  productoId String
  insumoId   String
  cantidad   Decimal @db.Decimal(10, 4)

  producto Producto @relation(fields: [productoId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])

  @@unique([productoId, insumoId])
  @@map("receta_items")
}

model InventarioSucursal {
  id         String  @id @default(uuid())
  sucursalId String
  insumoId   String
  existencia Decimal @default(0) @db.Decimal(12, 4)
  minimo     Decimal @default(0) @db.Decimal(12, 4)
  maximo     Decimal? @db.Decimal(12, 4)

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])

  @@unique([sucursalId, insumoId])
  @@index([sucursalId])
  @@map("inventario_sucursal")
}

model MovimientoInventario {
  id            String                   @id @default(uuid())
  sucursalId    String
  insumoId      String
  tipo          TipoMovimientoInventario
  cantidad      Decimal                  @db.Decimal(12, 4)
  motivo        String?
  referenciaId  String?                  // p.ej. pedidoId que generó la salida
  usuarioId     String?
  dispositivoId String?
  syncStatus    SyncStatus               @default(SYNCED)
  idempotencyKey String?                 @unique
  createdAt     DateTime                 @default(now())

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])

  @@index([sucursalId, insumoId])
  @@map("movimientos_inventario")
}

// ---------------------------------------------------------------------------
// Traspasos entre sucursales
// ---------------------------------------------------------------------------

model Traspaso {
  id                 String         @id @default(uuid())
  sucursalOrigenId   String
  sucursalDestinoId  String
  estado             EstadoTraspaso @default(SOLICITADO)
  usuarioSolicitaId  String?
  usuarioAutorizaId  String?
  usuarioEnviaId     String?
  usuarioRecibeId    String?
  fechaSolicitud     DateTime       @default(now())
  fechaAutorizacion  DateTime?
  fechaEnvio         DateTime?
  fechaRecepcion     DateTime?
  fechaValidacion    DateTime?
  notas              String?

  sucursalOrigen  Sucursal @relation("TraspasoOrigen", fields: [sucursalOrigenId], references: [id])
  sucursalDestino Sucursal @relation("TraspasoDestino", fields: [sucursalDestinoId], references: [id])

  items TraspasoItem[]

  @@index([sucursalOrigenId])
  @@index([sucursalDestinoId])
  @@map("traspasos")
}

model TraspasoItem {
  id                  String  @id @default(uuid())
  traspasoId          String
  insumoId            String
  cantidadSolicitada  Decimal @db.Decimal(12, 4)
  cantidadEnviada     Decimal? @db.Decimal(12, 4)
  cantidadRecibida    Decimal? @db.Decimal(12, 4)
  diferencia          Decimal? @db.Decimal(12, 4)

  traspaso Traspaso @relation(fields: [traspasoId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])

  @@map("traspaso_items")
}

// ---------------------------------------------------------------------------
// Clientes (CRM)
// ---------------------------------------------------------------------------

model Cliente {
  id             String   @id @default(uuid())
  empresaId      String
  nombre         String
  telefono       String?
  email          String?
  puntosLealtad  Int      @default(0)
  preferenciasJson Json?  @default("{}")
  createdAt      DateTime @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  pedidos Pedido[]

  @@index([empresaId])
  @@map("clientes")
}

// ---------------------------------------------------------------------------
// Auditoría y sincronización
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  empresaId      String?
  sucursalId     String?
  usuarioId      String?
  dispositivoId  String?
  entidad        String
  entidadId      String?
  accion         String
  datosAnteriores Json?
  datosNuevos    Json?
  ip             String?
  createdAt      DateTime @default(now())

  empresa     Empresa?     @relation(fields: [empresaId], references: [id])
  sucursal    Sucursal?    @relation(fields: [sucursalId], references: [id])
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id])
  dispositivo Dispositivo? @relation(fields: [dispositivoId], references: [id])

  @@index([empresaId, createdAt])
  @@index([sucursalId, createdAt])
  @@index([entidad, entidadId])
  @@map("audit_logs")
}

model SyncQueueItem {
  id             String        @id @default(uuid())
  dispositivoId  String
  entidad        String
  entidadId      String
  operacion      SyncOperacion
  payload        Json
  idempotencyKey String        @unique
  estado         SyncStatus    @default(PENDING)
  intentos       Int           @default(0)
  ultimoError    String?
  createdAt      DateTime      @default(now())
  syncedAt       DateTime?

  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id])

  @@index([dispositivoId, estado])
  @@map("sync_queue_items")
}
