{
  "name": "@hangar421/pos-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "HANGAR 421",
  "description": "POS de escritorio HANGAR 421 — Windows, táctil, offline-first",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron dist-electron/main.js",
    "build": "tsc -p tsconfig.json && vite build && tsc -p electron/tsconfig.json",
    "dist:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "dependencies": {
    "@hangar421/shared": "*",
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.hangar421.pos",
    "productName": "HANGAR 421 POS",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "directories": { "output": "release" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "xavisystem4-lab",
      "repo": "hangar421"
    }
  }
}
